# Dot directories (agent metadata, IDE configs, platform caches)
.*/
!.gitignore
!.gdignore

# Environment & secrets
.env
.env.*
!.env.example
node_modules/

# Godot engine cache and local import metadata
.godot/

# Temporary directories and transient outputs
temp/
*.stackdump
*.dmp
*.log
crash*.log

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class

# OS & Editor generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/

# Local execution logs & transient scratch dumps
scratch/logs/
scratch/audio_raw/
.studio/
node_modules
.git.studio-backup
dist/
output/
.playwright-cli/

# Local tool config and nested studio projects (machine-specific, never shared)
.ai-memory.toml
studio.json
Untitled game/

# Active task board for agents (AGENTS.md 12.5): local, overwritten every task
todo.md

# Agent session logs written by lifecycle hooks: local only
production/session-logs/
